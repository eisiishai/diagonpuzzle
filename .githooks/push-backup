#!/bin/sh
# Run by post-commit: pushes main and its version tags to the backup remote.
# GitHub gets them only by hand, with `npm run github`.
# Never forces and never stops anything: if a push can't be done, it prints
# a warning and the commit stays local until the next push.
# Turn off with `git config diagonpuzzle.autoPush false`. See docs/WORKFLOW.md.

RELEASE_BRANCH=main

[ "$(git config --bool diagonpuzzle.autoPush)" = "false" ] && exit 0

# Same rules as tagging: only main, and not in the middle of a rebase.
[ "$(git symbolic-ref --quiet --short HEAD)" = "$RELEASE_BRANCH" ] || exit 0
git_dir=$(git rev-parse --git-dir)
[ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] && exit 0

# push_to REMOTE NAME: NAME is what the messages call it.
push_to() {
  remote=$1
  name=$2
  warn() {
    echo "⚠ $name not updated: $1" >&2
    echo "  ${2:-The commit is safe locally. Push later with: git push $remote}" >&2
  }

  url=$(git remote get-url "$remote" 2>/dev/null)
  if [ -z "$url" ]; then
    warn "no '$remote' remote is set up."
    return
  fi
  # A local backup on a disk that isn't connected or mounted.
  case "$url" in
    /*)
      if [ ! -d "$url" ]; then
        warn "$url is not available (is the disk connected?)."
        return
      fi
      ;;
  esac

  # No password prompt in the middle of a commit: without a login, fail.
  if output=$(GIT_TERMINAL_PROMPT=0 git push --follow-tags --porcelain "$remote" "$RELEASE_BRANCH" 2>&1); then
    echo "Pushed to $remote."
  elif echo "$output" | grep -q '^!'; then
    echo "$output" | grep '^!' >&2
    warn "the push was rejected." \
      "If you amended an already pushed commit, see \"Amending\" in docs/WORKFLOW.md."
  else
    # Not reachable, or not logged in.
    echo "$output" | grep -E '^(fatal|error|remote):' >&2
    warn "the push failed."
  fi
}

push_to backup Backup
exit 0
