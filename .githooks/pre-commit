#!/bin/sh
# Stops a commit that adds lines looking private (private-lines), then runs
# the full check (lint, type check, tests, production build) before each
# commit, and the quick browser smoke tests when the game changes; stops the
# commit if anything fails. Skip in an emergency with
# `git commit --no-verify`. See docs/WORKFLOW.md.

# Added lines that look private (paths on this machine outside the
# repository, keys or tokens) never get into a commit unless allowed for
# this one commit: they would go public with the next npm run github.
private=$("$(dirname "$0")/private-lines" --cached)
if [ -n "$private" ] && [ "$ALLOW_PRIVATE_LINES" != 1 ]; then
  echo "pre-commit: these added lines look private (paths on this machine" >&2
  echo "outside the repository, keys or tokens):" >&2
  echo "$private" | sed 's/^/  /' >&2
  echo "Commit stopped. Use a placeholder instead (docs/backup.local.md," >&2
  echo "git-ignored, keeps the real value), or if they are fine to publish:" >&2
  echo "  ALLOW_PRIVATE_LINES=1 git commit ..." >&2
  exit 1
fi

# Hooks started from an editor may not have nvm's Node on the PATH.
if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
fi
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-commit: npm not found, so the checks can't run. Commit stopped." >&2
  echo "Use 'git commit --no-verify' to commit without checks." >&2
  exit 1
fi

# The checks run on the working tree, which differs from the commit if some
# changes are not staged.
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "pre-commit: note: some changes are not staged; the checks include them." >&2
fi

log="$(git rev-parse --git-dir)/pre-commit.log"
echo "pre-commit: running checks (npm run build)..."
if ! npm run build --silent >"$log" 2>&1; then
  cat "$log" >&2
  echo >&2
  echo "pre-commit: checks failed. Commit stopped." >&2
  exit 1
fi

# The quick browser smoke tests (npm run e2e, about 3 minutes), only when the
# commit changes the game or how it is built: doc-only commits stay fast.
if git diff --cached --name-only | grep -qE '^(src/|public/|e2e/|index\.html$|vite\.config\.ts$|playwright\.config\.ts$|package(-lock)?\.json$)'; then
  if ! node --input-type=module -e "
    import { chromium } from '@playwright/test';
    import { existsSync } from 'node:fs';
    process.exit(existsSync(chromium.executablePath()) ? 0 : 1);
  " >/dev/null 2>&1; then
    echo "pre-commit: warning: Playwright's Chromium is not installed, so the" >&2
    echo "browser smoke tests were skipped (setup in docs/WORKFLOW.md)." >&2
  else
    echo "pre-commit: running browser smoke tests (npm run e2e)..."
    if ! npm run e2e --silent >"$log" 2>&1; then
      cat "$log" >&2
      echo >&2
      echo "pre-commit: browser smoke tests failed. Commit stopped." >&2
      exit 1
    fi
  fi
fi

echo "pre-commit: all checks passed."
# For build-release (after the commit): the tree these checks were for.
git write-tree >"$(git rev-parse --git-dir)/checked-tree"
