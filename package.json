{
  "name": "diagonpuzzle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && tsc && npm test && npm run solutions && vite build",
    "lint": "eslint .",
    "dev": "vite",
    "test": "vitest run",
    "levels": "tsx scripts/levels.ts",
    "solutions": "tsx scripts/solutions.ts > docs/solutions.local.md",
    "version:major": "git config diagonpuzzle.nextMajor true && echo 'The next commit on main starts a new major version.'",
    "prepare": "git config core.hooksPath .githooks && git config push.followTags true"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
