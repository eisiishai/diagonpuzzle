{
  "name": "diagonpuzzle",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && tsc && npm test && npm run solutions && vite build",
    "lint": "eslint .",
    "dev": "vite",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "levels": "tsx scripts/levels.ts",
    "generate": "tsx scripts/generate.ts",
    "bonus": "tsx scripts/bonus.ts",
    "solutions": "tsx scripts/solutions.ts > docs/solutions.local.md",
    "e2e": "playwright test --project=desktop --project=phone",
    "e2e:full": "playwright test --project=desktop --project=phone --project=levels",
    "e2e:coverage": "E2E_COVERAGE=1 playwright test --project=desktop --project=phone --project=levels",
    "screenshots": "playwright test --project=screenshots",
    "version:major": "git config diagonpuzzle.nextMajor true && echo 'The next commit on main starts a new major version.'",
    "prepare": "git config core.hooksPath .githooks && git config push.followTags true",
    "alternatives": "tsx scripts/alternatives.ts",
    "trace": "tsx scripts/trace.ts",
    "github": "sh scripts/push-github.sh"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "monocart-coverage-reports": "^2.13.2",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
